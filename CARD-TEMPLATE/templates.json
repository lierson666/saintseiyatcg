{
  "_notas_pt": "Spec dos templates do card-forge. Coordenadas no canvas nativo 1488x2091 (2.5x3.5 in, ~595 dpi), medidas dos PSDs em FRAMES/. Peças vêm de pieces.json; 'dy' desloca a peça na vertical, 'rect' estica/move. Textos: x,y = centro.",
  "canvas": { "w": 1488, "h": 2091 },
  "styles": {
    "title":    { "font": "italic 700 {s}px Futura, 'Futura PT', 'Century Gothic', sans-serif", "glow": true },
    "subtitle": { "font": "300 {s}px Avenir, 'Avenir Next', 'Nunito Sans', sans-serif", "glow": false },
    "typeline": { "font": "700 {s}px Futura, 'Futura PT', 'Century Gothic', sans-serif", "glow": true },
    "number":   { "font": "italic 700 {s}px Futura, 'Futura PT', 'Century Gothic', sans-serif", "glow": true },
    "label":    { "font": "900 {s}px Avenir, 'Avenir Next', sans-serif", "glow": true },
    "rules":    { "font": "300 {s}px Avenir, 'Avenir Next', 'Nunito Sans', sans-serif", "bold": "900 {s}px Avenir, 'Avenir Next', sans-serif", "glow": false },
    "flavour":  { "font": "italic 400 {s}px 'ITC Avant Garde Gothic Pro', 'ITC Avant Garde Gothic', 'Century Gothic', Avenir, sans-serif", "glow": false }
  },
  "color": "#FFF0BF",
  "_factions_pt": "Pacote por facção, tirado do PSD do Deus. Peça 'athena/x' vira '<facção>/x' quando existe (desenhada no lugar da de Athena); senão a de Athena é tingida com 'color'. 'omit' = peças que a facção não usa.",
  "factions": {
    "athena":   { "color": "#FFF0BF", "glow": "rgba(255,252,0,0.55)", "frame": ["athena/vignette", "athena/frame"] },
    "hades":    { "color": "#C07CFF", "glow": "rgba(168,0,255,0.55)", "frame": ["hades/frame_1", "hades/frame_2"] },
    "ares":     { "color": "#FF6D6D", "glow": "rgba(255,0,0,0.55)", "frame": ["ares/frame_1", "ares/frame_2"] },
    "artemis":  { "color": "#BFFFCD", "glow": "rgba(0,255,30,0.55)", "frame": ["artemis/frame_1", "artemis/frame_2"], "omit": ["box_name", "box_subtitle"] },
    "poseidon": { "color": "#8FEEFF", "glow": "rgba(0,246,255,0.55)", "frame": ["poseidon/frame_1", "poseidon/frame_2", "poseidon/frame_3"] }
  },
  "typeToLayout": {
